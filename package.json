{
  "name": "@tailor-ai/campaign-routes",
  "version": "0.1.0",
  "description": "Serve the campaign page a visitor should get, from rules your marketing team publishes in Contentful, on a Next.js site. Never calls Tailor, never redirects, never sets a cookie.",
  "keywords": [
    "personalization",
    "ab-testing",
    "landing-page",
    "middleware",
    "edge",
    "nextjs",
    "contentful",
    "utm",
    "campaign"
  ],
  "license": "MIT",
  "author": "Tailor AI <hello@tailorhq.ai> (https://tailorhq.ai)",
  "homepage": "https://github.com/tailor-hq/campaign-routes#readme",
  "bugs": {
    "url": "https://github.com/tailor-hq/campaign-routes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-hq/campaign-routes.git"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./endpoint": {
      "types": "./dist/endpoint.d.ts",
      "import": "./dist/endpoint.js",
      "default": "./dist/endpoint.js"
    },
    "./contentful": {
      "types": "./dist/contentful.d.ts",
      "import": "./dist/contentful.js",
      "default": "./dist/contentful.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc --build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "jest --watchman=false --verbose --config jest.config.js",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.7.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
